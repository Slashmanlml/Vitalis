<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- "annotations" habilita la sintaxis de tipos anulables (string?, int?) sin
         activar el analisis de flujo. Silencia los avisos CS8632 sin llenar la
         compilacion de advertencias nuevas en el codigo de pruebas existente. -->
    <Nullable>annotations</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit" Version="2.5.0" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.5" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.InMemory" Version="8.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.11" />
    <PackageReference Include="FluentAssertions" Version="7.0.0" />
  </ItemGroup>

  <!-- Las librerías de pruebas arrastran versiones viejas de estos dos paquetes
       (4.3.0), con vulnerabilidades altas conocidas: GHSA-7jgj-8wvc-jh57 y
       GHSA-cmhx-cq75-c4mj. Nombrarlos acá fuerza las versiones corregidas.
       Solo afecta al proyecto de pruebas; la API publicada no los usa. Lo
       detectó el control de paquetes vulnerables de la CI. -->
  <ItemGroup>
    <PackageReference Include="System.Net.Http" Version="4.3.4" />
    <PackageReference Include="System.Text.RegularExpressions" Version="4.3.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Vitalis.Api\Vitalis.Api.csproj" />
    <ProjectReference Include="..\..\src\Vitalis.Application\Vitalis.Application.csproj" />
    <ProjectReference Include="..\..\src\Vitalis.Domain\Vitalis.Domain.csproj" />
    <ProjectReference Include="..\..\src\Vitalis.Infrastructure\Vitalis.Infrastructure.csproj" />
  </ItemGroup>

</Project>
