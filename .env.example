# Copiá este archivo a .env (que NO se sube a git) y completá los valores.
# Generar una clave aleatoria en PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_KEY=
POSTGRES_PASSWORD=
# true para la demo (usuarios de prueba). false en una instalación real.
DATOS_DEMO=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
URL_FRONTEND=http://localhost:8080
